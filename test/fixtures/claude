#!/usr/bin/env bash
# Fake `claude`. Mimics the real stream-json shape probed from Claude Code 2.1.238.
if [ "$1" = "--help" ]; then
  [ -n "$ARC_FAKE_HELP_FAIL" ] && exit 1
  OMIT=" ${ARC_FAKE_HELP_OMIT//,/ } "
  for FLAG in -p --output-format --verbose --model --effort --setting-sources --no-chrome --no-session-persistence --mcp-config --strict-mcp-config --allowedTools --json-schema; do
    [[ "$OMIT" = *" $FLAG "* ]] || printf '%s\n' "$FLAG"
  done
  exit 0
fi
MODEL="opus"; while [ $# -gt 0 ]; do case "$1" in --model) MODEL="$2"; shift 2;; *) shift;; esac; done
PAYLOAD="$ARC_FAKE_PAYLOAD"
[ -z "$PAYLOAD" ] && PAYLOAD='{"status":"done","noop":true,"noopReason":"fixture"}'
# ARC_FAKE_QUEUE=<dir>: serve one payload per call, in order. The design phase
# makes several different calls (extract -> charter -> scout plan -> report ->
# plan), so a single fixed payload cannot exercise it.
if [ -n "$ARC_FAKE_QUEUE" ]; then
  # Claim a slot ATOMICALLY: risk and implement now dispatch concurrently, and
  # the old read-increment counter double-served one slot and lost the other.
  # mv on one filesystem is atomic — the winner takes the slot, the loser
  # advances to the next.
  N=0
  while [ "$N" -lt 64 ]; do
    if mv "$ARC_FAKE_QUEUE/$N.json" "$ARC_FAKE_QUEUE/$N.taken.$$" 2>/dev/null; then
      PAYLOAD=$(cat "$ARC_FAKE_QUEUE/$N.taken.$$")
      break
    fi
    N=$((N + 1))
  done
fi
REPORTED="${ARC_FAKE_MODEL:-$MODEL}"
[ -n "$ARC_FAKE_NOINIT" ] && { echo '{"type":"system","subtype":"init"}'; exit 0; }
# A numeric ARC_FAKE_HANG > 1 sets the sleep duration, so a test can pgrep for
# ITS OWN hang instead of matching every "sleep 300" on the machine — two
# suites running concurrently used to cross-contaminate exactly there.
[ -n "$ARC_FAKE_HANG" ] && { echo '{"type":"system","subtype":"init"}'; case "$ARC_FAKE_HANG" in ''|1) sleep 300;; *) sleep "$ARC_FAKE_HANG";; esac; exit 0; }
# A payload of {"__hang": N} hangs THIS call only — for tests where one
# specific dispatch in a sequence must time out while its neighbours answer.
case "$PAYLOAD" in
  *'"__hang"'*)
    H=$(printf '%s' "$PAYLOAD" | sed -n 's/.*"__hang"[^0-9]*\([0-9]*\).*/\1/p')
    echo '{"type":"system","subtype":"init"}'; sleep "${H:-300}"; exit 0;;
esac
echo '{"type":"system","subtype":"init"}'
echo "{\"type\":\"assistant\",\"message\":{\"model\":\"$REPORTED\"}}"
if [ -n "$ARC_FAKE_ERROR" ]; then
  echo "{\"type\":\"result\",\"subtype\":\"error\",\"is_error\":true,\"modelUsage\":{\"$REPORTED\":{}},\"result\":\"${ARC_FAKE_ERRTEXT:-}\"}"
  exit 1
fi
printf '{"type":"result","subtype":"success","is_error":false,"modelUsage":{"%s":{"inputTokens":11,"cacheReadInputTokens":22,"cacheCreationInputTokens":33,"outputTokens":44,"costUSD":0.0123}},"result":%s}\n' \
  "$REPORTED" "$(printf '%s' "$PAYLOAD" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"
